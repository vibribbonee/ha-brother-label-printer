{
  "domain": "brother_label_printer",
  "name": "Brother Network Label Printer",
  "codeowners": [
    "@vibribbonee"
  ],
  "config_flow": true,
  "documentation": "https://github.com/vibribbonee/ha-brother-label-printer#readme",
  "integration_type": "device",
  "iot_class": "local_push",
  "requirements": [
    "brother-ql-inventree==1.3",
    "ptouch==1.1.0"
  ],
  "zeroconf": [
    {
      "type": "_pdl-datastream._tcp.local.",
      "properties": {
        "ty": "*ql-710w*"
      }
    },
    {
      "type": "_pdl-datastream._tcp.local.",
      "properties": {
        "ty": "*pt-e550w*"
      }
    }
  ],
  "version": "0.2.1",
  "issue_tracker": "https://github.com/vibribbonee/ha-brother-label-printer/issues"
}
